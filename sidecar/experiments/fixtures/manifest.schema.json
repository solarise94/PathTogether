{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://svs-viewer/sidecar/experiments/fixtures/manifest.schema.json",
  "title": "Phase 4 fixture manifest",
  "description": "Versioned, de-identified fixture manifest (§15.4). Generated by sidecar/experiments/fixtures/generate.py --pin against a running Flask. The committed manifest.example.json shows the shape with placeholder fingerprints until Wave 2 pins them.",
  "type": "object",
  "required": ["manifest_version", "generated_at", "fixtures"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "description": "ISO-8601 UTC, header only — NOT used for determinism downstream" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fixture_id", "file", "size_bytes", "sha256", "fingerprint", "width", "height", "level_downsamples", "mpp", "regions", "tags"],
        "additionalProperties": false,
        "properties": {
          "fixture_id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1, "description": "filename, must pass app.py _safe_name" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$|^[0-9A-Fa-f:-]+$" },
          "fingerprint": { "type": "string", "description": "from Flask _slide_fingerprint (mtime_ns:size)" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "level_downsamples": { "type": "array", "items": { "type": "number" }, "minItems": 1 },
          "mpp": { "type": ["number", "null"] },
          "regions": {
            "type": "array",
            "description": "Ground-truth regions the generator drew (bbox in level-0 px). bbox_revisit rubric assertions reference these labels.",
            "items": {
              "type": "object",
              "required": ["label", "x", "y", "w", "h"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "w": { "type": "integer", "minimum": 0 },
                "h": { "type": "integer", "minimum": 0 },
                "density": { "type": "string" }
              }
            }
          },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
